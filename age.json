---
layout: null
---

{% assign birth_year = site.data.age.birth_date | date: "%Y" | plus: 0 %}
{% assign birth_month = site.data.age.birth_date | date: "%m" | plus: 0 %}
{% assign birth_day = site.data.age.birth_date | date: "%d" | plus: 0 %}

{% assign current_year = site.time | date: "%Y" | plus: 0 %}
{% assign current_month = site.time | date: "%m" | plus: 0 %}
{% assign current_day = site.time | date: "%d" | plus: 0 %}

{% assign age = current_year | minus: birth_year %}

{% if current_month < birth_month or current_month == birth_month and current_day < birth_day %}
  {% assign age = age | minus: 1 %}
{% endif %}

{
  "schemaVersion": 1,
  "label": "age",
  "message": "{{ age }} years",
  "color": "blue"
}
